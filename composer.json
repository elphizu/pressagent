{
  "name": "elphizu/pressagent",
  "description": "AI agent discovery and interoperability for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/elphizu/pressagent",
  "keywords": [
    "wordpress",
    "ai",
    "agents",
    "llms",
    "mcp",
    "abilities-api"
  ],
  "support": {
    "issues": "https://github.com/elphizu/pressagent/issues",
    "source": "https://github.com/elphizu/pressagent"
  },
  "require": {
    "php": ">=7.4"
  },
  "autoload": {
    "classmap": [
      "includes/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "PressAgent\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "phpcompatibility/php-compatibility": "^9.3.5",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "make-pot": "wp i18n make-pot . languages/pressagent.pot --domain=pressagent",
    "check": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
